# Copie este arquivo para ".env" e preencha os valores.
# O .env NÃO vai para o Git (está no .gitignore).

# Usuário e senha do PostgreSQL do container
POSTGRES_USER=usermanagement
POSTGRES_PASSWORD=

# Chave de assinatura do JWT da API (mínimo de 32 caracteres).
# Para gerar no PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_KEY=
